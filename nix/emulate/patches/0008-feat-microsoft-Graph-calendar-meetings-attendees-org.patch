--- a/packages/@emulators/microsoft/README.md
+++ b/packages/@emulators/microsoft/README.md
@@ -63,6 +63,8 @@ Each user's mailbox starts with the well-known folders (Inbox, Drafts, Sent Item
 
 Events live in the user's one calendar. Times are UTC: requests give them with `timeZone: "UTC"` (others are refused), and responses give them so, as with `Prefer: outlook.timezone="UTC"`. A series' `recurrence` may follow a `daily`, `weekly`, `absoluteMonthly` or `absoluteYearly` pattern, over an `endDate`, `numbered` or `noEnd` range (expanded three years ahead). Changing or deleting one of its occurrences, by the occurrence's id, makes an exception of it.
 
+An event keeps its `body` (`text` or `html`), `showAs` and `attendees` as given; `isOnlineMeeting: true` gives it an `onlineMeeting.joinUrl` at the emulator. What Graph sets itself of a meeting someone else organizes, the emulator takes too, to seed one: its `organizer`, the user's `responseStatus` (`notResponded` by default, `organizer` for the user's own) and `isCancelled`.
+
 `calendarView` lists the events overlapping `startDateTime`–`endDateTime`, series as their occurrences and exceptions. Its `delta` lists them, then, from its `@odata.deltaLink`, those changed since, and as `@removed` those deleted, cancelled or moved out of the window. An unknown delta token answers 410 `SyncStateNotFound`.
 
 ## Seed Configuration
diff --git a/packages/@emulators/microsoft/src/__tests__/calendar.test.ts b/packages/@emulators/microsoft/src/__tests__/calendar.test.ts
index f8a15a3..d20f874 100644
--- a/packages/@emulators/microsoft/src/__tests__/calendar.test.ts
+++ b/packages/@emulators/microsoft/src/__tests__/calendar.test.ts
@@ -193,4 +193,36 @@ describe("Microsoft Graph calendar", () => {
     });
     expect(relative.status).toBe(400);
   });
+
+  it("keeps a meeting's attendees, organizer, answer, body and online meeting", async () => {
+    const own = await create({ subject: "Plain", start: utc("2026-11-10T09:00:00"), end: utc("2026-11-10T10:00:00") });
+    expect([own.organizer.emailAddress.address, own.responseStatus.response, own.showAs]).toEqual([ALICE, "organizer", "busy"]);
+    expect([own.isOnlineMeeting, own.onlineMeeting, own.isCancelled]).toEqual([false, null, false]);
+    const attendees = [{ emailAddress: { name: "Bob", address: "bob@example.com" }, type: "required", status: { response: "accepted" } }];
+    const meeting = await create({
+      subject: "Sync",
+      start: utc("2026-11-11T09:00:00"),
+      end: utc("2026-11-11T10:00:00"),
+      body: { contentType: "html", content: "<p>Agenda</p>" },
+      organizer: { emailAddress: { name: "Bob", address: "bob@example.com" } },
+      attendees,
+      showAs: "tentative",
+      isOnlineMeeting: true,
+    });
+    expect(meeting.organizer.emailAddress).toEqual({ name: "Bob", address: "bob@example.com" });
+    expect([meeting.responseStatus.response, meeting.showAs, meeting.body]).toEqual([
+      "notResponded",
+      "tentative",
+      { contentType: "html", content: "<p>Agenda</p>" },
+    ]);
+    expect(meeting.attendees).toEqual(attendees);
+    expect(meeting.onlineMeeting.joinUrl).toBe(`${base}/meet/${meeting.id}`);
+    await json(`/v1.0/me/events/${meeting.id}`, {
+      method: "PATCH",
+      body: JSON.stringify({ isCancelled: true, responseStatus: { response: "declined" } }),
+    });
+    const listed = (await json(`/v1.0/me/calendarView?${WINDOW}`)).value.find((e: any) => e.id === meeting.id);
+    expect([listed.isCancelled, listed.responseStatus.response]).toEqual([true, "declined"]);
+    expect((await request("/v1.0/me/events", { method: "POST", body: JSON.stringify({ ...meeting, showAs: "away" }) })).status).toBe(400);
+  });
 });
