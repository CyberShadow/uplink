+  /** The folder's messages; of `$filter`, only `internetMessageId eq '…'`. */
+  app.get("/v1.0/me/mailFolders/:folder/messages", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const folder = findFolder(ms, email, c.req.param("folder"));
+    if (!folder) return folderNotFound(c);
+    let messages = ms.messages.findBy("user_email", email).filter((m) => m.folder_id === folder.folder_id);
+    const filter = c.req.query("$filter");
+    if (filter !== undefined) {
+      const id = filter.match(/^internetMessageId eq '((?:[^']|'')*)'$/)?.[1];
+      if (id === undefined) {
+        return graphError(c, 400, "ErrorInvalidUrlQueryFilter", "The emulator filters by internetMessageId only.");
+      }
+      messages = messages.filter((m) => m.internet_message_id === id.replace(/''/g, "'"));
+    }
+    return c.json({ value: messages.map(formatMessage) });
+  });
