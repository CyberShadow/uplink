+  it("sends a draft created from MIME, which keeps its id", async () => {
+    const raw = [`From: ${ALICE}`, `To: ${BOB}`, "Subject: Drafted", "Message-ID: <drafted@example.com>", "", "Hi"].join(
+      "\r\n",
+    );
+    const created = await request("/v1.0/me/messages", {
+      method: "POST",
+      headers: { "Content-Type": "text/plain" },
+      body: Buffer.from(raw).toString("base64"),
+    });
+    expect(created.status).toBe(201);
+    const draft = (await created.json()) as any;
+    expect(draft.isDraft).toBe(true);
+    const filter = encodeURIComponent("internetMessageId eq '<drafted@example.com>'");
+    const found = await json(`/v1.0/me/mailFolders/drafts/messages?$filter=${filter}`);
+    expect(found.value.map((m: any) => m.id)).toEqual([draft.id]);
+
+    expect((await request(`/v1.0/me/messages/${draft.id}/send`, { method: "POST" })).status).toBe(202);
+    const sent = await json(`/v1.0/me/messages/${draft.id}`);
+    expect([sent.isDraft, sent.parentFolderId]).toEqual([false, (await json("/v1.0/me/mailFolders/sentitems")).id]);
+    expect((await json(`/v1.0/me/mailFolders/drafts/messages?$filter=${filter}`)).value).toEqual([]);
+    const bobs = await json("/v1.0/me/mailFolders/inbox/messages/delta", {}, "bob-token");
+    expect(bobs.value.map((m: any) => m.subject)).toEqual(["Drafted"]);
+    // Sent once only.
+    expect((await request(`/v1.0/me/messages/${draft.id}/send`, { method: "POST" })).status).toBe(400);
+  });
+
