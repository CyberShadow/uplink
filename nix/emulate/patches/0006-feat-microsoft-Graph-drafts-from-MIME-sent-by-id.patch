+  /** A draft, from MIME: Graph files it in Drafts. */
+  app.post("/v1.0/me/messages", async (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const mime = await mimeBody(c);
+    if (mime === null) {
+      return graphError(c, 400, "ErrorMimeContentInvalid", "The emulator creates messages from MIME only.");
+    }
+    const message = createMessage(store, email, findFolder(ms, email, "drafts")!, { mime, isDraft: true });
+    return c.json(formatMessage(message), 201);
+  });
+
   // ---------- Sending ----------
 
+  /** Delivers `mime` to each recipient that is a seeded user; `null` if
+   * it has none. Recipients do not see who else was Bcc'd. */
+  const deliver = (mime: string, receivedAt: string): true | null => {
+    const headers = parseHeaders(mime);
+    const recipients = ["to", "cc", "bcc"].flatMap((h) => parseAddresses(headers.get(h) ?? ""));
+    if (recipients.length === 0) return null;
+    const delivered = mime.replace(/^Bcc:.*(?:\r?\n[ \t].*)*\r?\n/im, "");
+    for (const address of new Set(recipients)) {
+      const recipient = ms.users.findOneBy("email", address as never);
+      if (!recipient) continue;
+      const inbox = findFolder(ms, recipient.email, "inbox")!;
+      createMessage(store, recipient.email, inbox, { mime: delivered, receivedAt });
+    }
+    return true;
+  };
+
+  const invalidRecipients = (c: Context) =>
+    graphError(c, 400, "ErrorInvalidRecipients", "At least one recipient is not valid.");
+
+  /** Sends a draft: it keeps its id, moving to Sent Items. */
+  app.post(
+    "/v1.0/me/messages/:message/send",
+    withMessage((c, email, message) => {
+      if (!message.is_draft) {
+        return graphError(c, 400, "ErrorInvalidRequest", "Only a draft can be sent.");
+      }
+      const receivedAt = new Date().toISOString();
+      if (deliver(message.mime, receivedAt) === null) return invalidRecipients(c);
+      const sent = findFolder(ms, email, "sentitems")!;
+      changeMessage(store, message, { folder_id: sent.folder_id, is_read: true, is_draft: false });
+      return c.body(null, 202);
+    }),
+  );
+
   app.post("/v1.0/me/sendMail", async (c) => {
     const email = user(c);
     if (email instanceof Response) return email;
