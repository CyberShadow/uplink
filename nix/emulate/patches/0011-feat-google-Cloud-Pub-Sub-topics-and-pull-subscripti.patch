diff --git a/packages/@emulators/google/src/routes/pubsub.ts b/packages/@emulators/google/src/routes/pubsub.ts
new file mode 100644
index 0000000..ea48af1
--- /dev/null
+++ b/packages/@emulators/google/src/routes/pubsub.ts
@@ -0,0 +1,229 @@
+import type { Context, RouteContext, Store } from "@emulators/core";
+import { googleApiError } from "../helpers.js";
+import { parseGoogleBody, requireGoogleAuth } from "../route-helpers.js";
+
+// Cloud Pub/Sub, as far as Gmail push notifications go: topics with an IAM
+// policy, pull subscriptions (pull waits a bounded time for a message, as
+// Pub/Sub does unless asked to return at once), and acknowledgement.
+
+/** Who Gmail publishes as; a watch needs it allowed to publish. */
+export const GMAIL_PUBLISHER = "serviceAccount:gmail-api-push@system.gserviceaccount.com";
+const PUBLISHER_ROLE = "roles/pubsub.publisher";
+const PUBSUB_STATE_KEY = "google.pubsub";
+/** How long a pull waits for a message before answering with none. */
+const PULL_WAIT_MS = 10_000;
+/** How long a message pulled stays unacknowledged before it is redelivered. */
+const DEFAULT_ACK_DEADLINE_SECONDS = 10;
+
+interface IamBinding {
+  role: string;
+  members: string[];
+}
+
+interface Topic {
+  bindings: IamBinding[];
+  etag: number;
+}
+
+interface PubsubMessage {
+  messageId: string;
+  data: string;
+  publishTime: string;
+}
+
+interface Outstanding {
+  message: PubsubMessage;
+  /** When it is redelivered, unless acknowledged first (unix ms). */
+  deadline: number;
+}
+
+interface Subscription {
+  topic: string;
+  ackDeadlineSeconds: number;
+  queue: PubsubMessage[];
+  outstanding: Map<string, Outstanding>;
+  /** Pulls waiting for a message. */
+  waiting: Set<() => void>;
+}
+
+interface PubsubState {
+  topics: Map<string, Topic>;
+  subscriptions: Map<string, Subscription>;
+  nextId: number;
+}
+
+function state(store: Store): PubsubState {
+  let s = store.getData<PubsubState>(PUBSUB_STATE_KEY);
+  if (!s) {
+    s = { topics: new Map(), subscriptions: new Map(), nextId: 1 };
+    store.setData(PUBSUB_STATE_KEY, s);
+  }
+  return s;
+}
+
+/** Whether `topic` exists and Gmail may publish to it. */
+export function gmailMayPublish(store: Store, topic: string): boolean {
+  const t = state(store).topics.get(topic);
+  return !!t?.bindings.some((b) => b.role === PUBLISHER_ROLE && b.members.includes(GMAIL_PUBLISHER));
+}
+
+/** Publishes `data` (JSON) to every subscription of `topic`. */
+export function publish(store: Store, topic: string, data: unknown): void {
+  const s = state(store);
+  if (!s.topics.has(topic)) return;
+  const message: PubsubMessage = {
+    messageId: String(s.nextId++),
+    data: Buffer.from(JSON.stringify(data)).toString("base64"),
+    publishTime: new Date().toISOString(),
+  };
+  for (const sub of s.subscriptions.values()) {
+    if (sub.topic !== topic) continue;
+    sub.queue.push(message);
+    for (const wake of sub.waiting) wake();
+  }
+}
+
+function pubsubError(c: Context, code: 400 | 403 | 404 | 409, message: string, status: string) {
+  return c.json({ error: { code, message, status } }, code);
+}
+
+/** The resource and the method of a `name:method` path segment. */
+function splitMethod(segment: string): [string, string | undefined] {
+  const at = segment.indexOf(":");
+  return at === -1 ? [segment, undefined] : [segment.slice(0, at), segment.slice(at + 1)];
+}
+
+/** Puts the messages whose deadline has passed back on the queue. */
+function redeliver(sub: Subscription): void {
+  const now = Date.now();
+  for (const [ackId, o] of sub.outstanding) {
+    if (o.deadline <= now) {
+      sub.outstanding.delete(ackId);
+      sub.queue.unshift(o.message);
+    }
+  }
+}
+
+export function pubsubRoutes({ app, store }: RouteContext): void {
+  app.put("/v1/projects/:project/topics/:topic", (c) => {
+    const auth = requireGoogleAuth(c);
+    if (auth instanceof Response) return auth;
+    const name = `projects/${c.req.param("project")}/topics/${c.req.param("topic")}`;
+    const s = state(store);
+    if (s.topics.has(name)) return pubsubError(c, 409, "Resource already exists in the project", "ALREADY_EXISTS");
+    s.topics.set(name, { bindings: [], etag: 1 });
+    return c.json({ name });
+  });
+
+  app.post("/v1/projects/:project/topics/:topicMethod", async (c) => {
+    const auth = requireGoogleAuth(c);
+    if (auth instanceof Response) return auth;
+    const [topicId, method] = splitMethod(c.req.param("topicMethod"));
+    const name = `projects/${c.req.param("project")}/topics/${topicId}`;
+    const topic = state(store).topics.get(name);
+    if (!topic) return pubsubError(c, 404, "Resource not found", "NOT_FOUND");
+    const policy = () => ({
+      version: 1,
+      etag: Buffer.from(String(topic.etag)).toString("base64"),
+      bindings: topic.bindings,
+    });
+    switch (method) {
+      case "getIamPolicy":
+        return c.json(policy());
+      case "setIamPolicy": {
+        const body = await parseGoogleBody(c);
+        const given = body.policy as { etag?: string; bindings?: IamBinding[] } | undefined;
+        if (!given) return pubsubError(c, 400, "Policy is required.", "INVALID_ARGUMENT");
+        if (given.etag !== undefined && given.etag !== policy().etag) {
+          return pubsubError(c, 409, "There were concurrent policy changes.", "ABORTED");
+        }
+        topic.bindings = given.bindings ?? [];
+        topic.etag++;
+        return c.json(policy());
+      }
+      default:
+        return pubsubError(c, 404, "Method not found.", "NOT_FOUND");
+    }
+  });
+
+  app.put("/v1/projects/:project/subscriptions/:subscription", async (c) => {
+    const auth = requireGoogleAuth(c);
+    if (auth instanceof Response) return auth;
+    const name = `projects/${c.req.param("project")}/subscriptions/${c.req.param("subscription")}`;
+    const s = state(store);
+    if (s.subscriptions.has(name)) {
+      return pubsubError(c, 409, "Resource already exists in the project", "ALREADY_EXISTS");
+    }
+    const body = await parseGoogleBody(c);
+    const topic = typeof body.topic === "string" ? body.topic : "";
+    if (!s.topics.has(topic)) return pubsubError(c, 404, "Resource not found", "NOT_FOUND");
+    const ackDeadlineSeconds =
+      typeof body.ackDeadlineSeconds === "number" ? body.ackDeadlineSeconds : DEFAULT_ACK_DEADLINE_SECONDS;
+    s.subscriptions.set(name, {
+      topic,
+      ackDeadlineSeconds,
+      queue: [],
+      outstanding: new Map(),
+      waiting: new Set(),
+    });
+    return c.json({ name, topic, ackDeadlineSeconds, expirationPolicy: body.expirationPolicy ?? { ttl: "2678400s" } });
+  });
+
+  app.get("/v1/projects/:project/subscriptions/:subscription", (c) => {
+    const auth = requireGoogleAuth(c);
+    if (auth instanceof Response) return auth;
+    const name = `projects/${c.req.param("project")}/subscriptions/${c.req.param("subscription")}`;
+    const sub = state(store).subscriptions.get(name);
+    if (!sub) return pubsubError(c, 404, "Resource not found", "NOT_FOUND");
+    return c.json({ name, topic: sub.topic, ackDeadlineSeconds: sub.ackDeadlineSeconds });
+  });
+
+  app.post("/v1/projects/:project/subscriptions/:subscriptionMethod", async (c) => {
+    const auth = requireGoogleAuth(c);
+    if (auth instanceof Response) return auth;
+    const [subscriptionId, method] = splitMethod(c.req.param("subscriptionMethod"));
+    const name = `projects/${c.req.param("project")}/subscriptions/${subscriptionId}`;
+    const sub = state(store).subscriptions.get(name);
+    if (!sub) return pubsubError(c, 404, "Resource not found", "NOT_FOUND");
+    const body = await parseGoogleBody(c);
+    switch (method) {
+      case "pull": {
+        const max = typeof body.maxMessages === "number" ? body.maxMessages : 0;
+        if (max <= 0) return pubsubError(c, 400, "maxMessages must be positive.", "INVALID_ARGUMENT");
+        redeliver(sub);
+        const gone = c.req.raw.signal;
+        if (sub.queue.length === 0 && body.returnImmediately !== true && !gone.aborted) {
+          // Until a message is published, the wait is over, or the client
+          // has gone.
+          await new Promise<void>((resolve) => {
+            const wake = () => {
+              clearTimeout(timer);
+              sub.waiting.delete(wake);
+              gone.removeEventListener("abort", wake);
+              resolve();
+            };
+            const timer = setTimeout(wake, PULL_WAIT_MS);
+            sub.waiting.add(wake);
+            gone.addEventListener("abort", wake);
+          });
+        }
+        // Messages are not handed to a client that has gone.
+        if (gone.aborted) return c.json({});
+        const deadline = Date.now() + sub.ackDeadlineSeconds * 1000;
+        const receivedMessages = sub.queue.splice(0, max).map((message) => {
+          const ackId = `${message.messageId}-${Math.random().toString(36).slice(2)}`;
+          sub.outstanding.set(ackId, { message, deadline });
+          return { ackId, message };
+        });
+        return c.json(receivedMessages.length > 0 ? { receivedMessages } : {});
+      }
+      case "acknowledge": {
+        const ackIds = Array.isArray(body.ackIds) ? (body.ackIds as unknown[]) : [];
+        for (const ackId of ackIds) sub.outstanding.delete(String(ackId));
+        return c.json({});
+      }
+      default:
+        return pubsubError(c, 404, "Method not found.", "NOT_FOUND");
+    }
+  });
+}
