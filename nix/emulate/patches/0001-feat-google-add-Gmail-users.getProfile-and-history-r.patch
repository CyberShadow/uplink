+export const GMAIL_HISTORY_LIMIT_KEY = "google.gmail.historyLimit";
+
+/**
+ * Whether history.list can serve changes after startHistoryId, given that only
+ * the newest `historyLimit` history records are retained.
+ */
+export function isHistoryRetained(
+  gs: GoogleStore,
+  userEmail: string,
+  startHistoryId: string,
+  historyLimit: number | undefined,
+): boolean {
+  if (historyLimit === undefined) return true;
+  const recordIds = Array.from(new Set(gs.history.findBy("user_email", userEmail).map((event) => event.gmail_id))).sort(
+    compareHistoryIds,
+  );
+  const discarded = recordIds.slice(0, Math.max(0, recordIds.length - historyLimit));
+  return discarded.length === 0 || compareHistoryIds(startHistoryId, discarded[discarded.length - 1]) >= 0;
+}
