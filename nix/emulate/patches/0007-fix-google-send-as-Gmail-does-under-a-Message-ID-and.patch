 packages/@emulators/google/src/helpers.ts     | 32 ++++++++--
 .../@emulators/google/src/routes/drafts.ts    |  3 +-
 .../@emulators/google/src/routes/messages.ts  |  4 ++
 4 files changed, 89 insertions(+), 8 deletions(-)

