+  it("accepts drafts as multipart uploads", async () => {
+    const mime = Buffer.from(
+      buildRawMessage({
+        from: "testuser@example.com",
+        to: "Support <support@example.com>",
+        subject: "Uploaded draft",
+        body_text: "Drafted by upload.",
+        message_id: "<draft-upload@example.com>",
+      }),
+      "base64url",
+    ).toString("utf8");
+    const body = [
+      "--b0undary",
+      "Content-Type: application/json; charset=UTF-8",
+      "",
+      JSON.stringify({ message: { threadId: "thread_support" } }),
+      "--b0undary",
+      "Content-Type: message/rfc822",
+      "",
+      mime,
+      "--b0undary--",
+      "",
+    ].join("\r\n");
+
+    const createRes = await app.request(`${base}/upload/gmail/v1/users/me/drafts?uploadType=multipart`, {
+      method: "POST",
+      headers: authHeaders({ "Content-Type": 'multipart/related; boundary="b0undary"' }),
+      body,
+    });
+
+    expect(createRes.status).toBe(200);
+    const created = (await createRes.json()) as { id: string; message: { id: string; threadId: string } };
+    expect(created.message.threadId).toBe("thread_support");
+    const rawRes = await app.request(`${base}/gmail/v1/users/me/messages/${created.message.id}?format=raw`, {
+      headers: authHeaders(),
+    });
+    const fetched = (await rawRes.json()) as { raw: string };
     expect(Buffer.from(fetched.raw, "base64url").toString("utf8")).toBe(mime);
   });
 
diff --git a/packages/@emulators/google/src/helpers.ts b/packages/@emulators/google/src/helpers.ts
index b7f21ad..0161606 100644
--- a/packages/@emulators/google/src/helpers.ts
+++ b/packages/@emulators/google/src/helpers.ts
@@ -691,19 +691,39 @@ export function updateDraftMessage(
   return { draft: syncDraftState(gs, updated, draft.gmail_id) ?? draft, message: updated };
 }
 
+/**
+ * The raw message (base64url) as Gmail sends it: under a Message-ID and a
+ * Date of its own, whatever the sender gave.
+ */
+export function asSentByGmail(raw: string, at: Date): string {
+  const text = decodeBase64Like(raw).toString("latin1");
+  const end = text.search(/\r?\n\r?\n/);
+  const head = end === -1 ? text : text.slice(0, end);
+  const body = end === -1 ? "" : text.slice(end);
+  const fields = head.split(/\r?\n(?![ \t])/).filter((field) => !/^(message-id|date)\s*:/i.test(field));
+  fields.push(`Message-ID: <${randomBytes(16).toString("hex")}@mail.gmail.com>`, `Date: ${at.toUTCString()}`);
+  return Buffer.from(fields.join("\r\n") + body, "latin1").toString("base64url");
+}
+
+/**
+ * Sends the draft as Gmail does: as a new message of the draft's thread,
+ * with an id and a Message-ID of its own; the draft is gone.
+ */
 export function sendDraftMessage(gs: GoogleStore, draft: GoogleDraft): GoogleMessage | null {
   const message = getDraftMessage(gs, draft);
   if (!message) {
     gs.drafts.delete(draft.id);
     return null;
   }
+  if (message.raw === null) throw new Error(`draft ${draft.gmail_id} has no raw message`);
 
-  const sent = markMessageModified(
-    gs,
-    message,
-    message.label_ids.filter((labelId) => labelId !== "DRAFT").concat("SENT"),
-  );
-  clearDraftRecordsForMessage(gs, message.user_email, message.gmail_id);
+  const sent = createStoredMessage(gs, {
+    user_email: message.user_email,
+    raw: asSentByGmail(message.raw, new Date()),
+    thread_id: message.thread_id,
+    label_ids: message.label_ids.filter((labelId) => labelId !== "DRAFT").concat("SENT"),
+  });
+  deleteMessage(gs, message);
   return sent;
 }
 
