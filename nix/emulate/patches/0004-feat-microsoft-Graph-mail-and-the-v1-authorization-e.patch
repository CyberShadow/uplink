diff --git a/packages/@emulators/microsoft/src/mail.ts b/packages/@emulators/microsoft/src/mail.ts
new file mode 100644
index 0000000..aefa23c
--- /dev/null
+++ b/packages/@emulators/microsoft/src/mail.ts
@@ -0,0 +1,233 @@
+import { randomBytes } from "crypto";
+import type { Store } from "@emulators/core";
+import { getMicrosoftStore, type MicrosoftStore } from "./store.js";
+import type { MicrosoftMailFolder, MicrosoftMessage } from "./entities.js";
+
+/** The folders every mailbox has, by the names Graph accepts for them. */
+export const WELL_KNOWN_FOLDERS: Record<string, string> = {
+  inbox: "Inbox",
+  drafts: "Drafts",
+  sentitems: "Sent Items",
+  deleteditems: "Deleted Items",
+  junkemail: "Junk Email",
+  archive: "Archive",
+  outbox: "Outbox",
+};
+
+/** An id in the shape of Graph's: opaque, URL-safe base64. */
+export function generateGraphId(prefix: string): string {
+  return prefix + randomBytes(24).toString("base64url");
+}
+
+export function ensureMailbox(ms: MicrosoftStore, email: string): void {
+  if (ms.mailFolders.findBy("user_email", email).length > 0) return;
+  for (const [wellKnown, name] of Object.entries(WELL_KNOWN_FOLDERS)) {
+    ms.mailFolders.insert({
+      folder_id: generateGraphId("AAMkFolder"),
+      user_email: email,
+      display_name: name,
+      parent_folder_id: null,
+      well_known_name: wellKnown,
+    });
+  }
+}
+
+/** A folder of the mailbox by id or well-known name. */
+export function findFolder(ms: MicrosoftStore, email: string, idOrName: string): MicrosoftMailFolder | undefined {
+  ensureMailbox(ms, email);
+  const folders = ms.mailFolders.findBy("user_email", email);
+  const name = idOrName.toLowerCase();
+  return folders.find((f) => f.folder_id === idOrName) ?? folders.find((f) => f.well_known_name === name);
+}
+
+export function findMessage(ms: MicrosoftStore, email: string, id: string): MicrosoftMessage | undefined {
+  return ms.messages.findBy("message_id", id).find((m) => m.user_email === email);
+}
+
+/** Advances the mailbox's change counter; delta tokens are its values. */
+export function nextChange(store: Store, email: string): number {
+  let counters = store.getData<Map<string, number>>("microsoft.mail.changes");
+  if (!counters) {
+    counters = new Map();
+    store.setData("microsoft.mail.changes", counters);
+  }
+  const next = (counters.get(email) ?? 0) + 1;
+  counters.set(email, next);
+  return next;
+}
+
+export function currentChange(store: Store, email: string): number {
+  return store.getData<Map<string, number>>("microsoft.mail.changes")?.get(email) ?? 0;
+}
+
+export interface MessageInput {
+  mime: string;
+  isRead?: boolean;
+  isDraft?: boolean;
+  receivedAt?: string;
+}
+
+/** Stores `input.mime` in the folder, as a new message. */
+export function createMessage(
+  store: Store,
+  email: string,
+  folder: MicrosoftMailFolder,
+  input: MessageInput,
+): MicrosoftMessage {
+  const ms = getMicrosoftStore(store);
+  const headers = parseHeaders(input.mime);
+  const from = parseMailbox(headers.get("from") ?? "");
+  const messageId = headers.get("message-id")?.trim() ?? `<${generateGraphId("")}@emulate.microsoft.local>`;
+  const date = Date.parse(headers.get("date") ?? "");
+  return ms.messages.insert({
+    message_id: generateGraphId("AAMkMessage"),
+    user_email: email,
+    folder_id: folder.folder_id,
+    mime: input.mime,
+    subject: headers.get("subject") ?? "",
+    from_name: from?.name ?? null,
+    from_address: from?.address ?? null,
+    internet_message_id: messageId,
+    conversation_id: conversationOf(ms, email, headers),
+    received_at: input.receivedAt ?? (Number.isNaN(date) ? new Date() : new Date(date)).toISOString(),
+    is_read: input.isRead ?? false,
+    is_draft: input.isDraft ?? false,
+    flag_status: "notFlagged",
+    importance: "normal",
+    categories: [],
+    change: nextChange(store, email),
+  });
+}
+
+/** The conversation of the message replied to, if the mailbox has it. */
+function conversationOf(ms: MicrosoftStore, email: string, headers: Map<string, string>): string {
+  const referenced = `${headers.get("in-reply-to") ?? ""} ${headers.get("references") ?? ""}`.match(/<[^>]+>/g) ?? [];
+  const mailbox = ms.messages.findBy("user_email", email);
+  for (const id of referenced) {
+    const original = mailbox.find((m) => m.internet_message_id === id);
+    if (original) return original.conversation_id;
+  }
+  return generateGraphId("AAQkConversation");
+}
+
+/** Records a change to the message, and its leaving a folder if it did. */
+export function changeMessage(
+  store: Store,
+  message: MicrosoftMessage,
+  update: Partial<Pick<MicrosoftMessage, "folder_id" | "is_read" | "flag_status" | "importance" | "categories">>,
+): MicrosoftMessage {
+  const ms = getMicrosoftStore(store);
+  const change = nextChange(store, message.user_email);
+  if (update.folder_id !== undefined && update.folder_id !== message.folder_id) {
+    recordRemoval(ms, message, change);
+  }
+  return ms.messages.update(message.id, { ...update, change })!;
+}
+
+export function deleteMessage(store: Store, message: MicrosoftMessage): void {
+  const ms = getMicrosoftStore(store);
+  recordRemoval(ms, message, nextChange(store, message.user_email));
+  ms.messages.delete(message.id);
+}
+
+function recordRemoval(ms: MicrosoftStore, message: MicrosoftMessage, change: number): void {
+  ms.messageRemovals.insert({
+    user_email: message.user_email,
+    folder_id: message.folder_id,
+    message_id: message.message_id,
+    change,
+  });
+}
+
+/** The folder's changes after `since`, oldest first: its messages that
+ * changed, and those that left it. */
+export function folderChanges(
+  ms: MicrosoftStore,
+  email: string,
+  folderId: string,
+  since: number,
+  upto: number,
+): Array<{ change: number; message: MicrosoftMessage } | { change: number; removed: string }> {
+  const changed = ms.messages
+    .findBy("user_email", email)
+    .filter((m) => m.folder_id === folderId && m.change > since && m.change <= upto)
+    .map((message) => ({ change: message.change, message }));
+  const present = new Set(changed.map((c) => c.message.message_id));
+  const removed = ms.messageRemovals
+    .findBy("user_email", email)
+    .filter((r) => r.folder_id === folderId && r.change > since && r.change <= upto)
+    // A message that left and came back is reported as it is now.
+    .filter((r) => !present.has(r.message_id))
+    .map((r) => ({ change: r.change, removed: r.message_id }));
+  const latest = new Map<string, { change: number; removed: string }>();
+  for (const r of removed) latest.set(r.removed, r);
+  return [...changed, ...latest.values()].sort((a, b) => a.change - b.change);
+}
+
+/** Graph's representation of the message. */
+export function formatMessage(message: MicrosoftMessage) {
+  const address = (name: string | null, address: string | null) =>
+    address === null ? null : { emailAddress: { name: name ?? address, address } };
+  return {
+    "@odata.type": "#microsoft.graph.message",
+    id: message.message_id,
+    createdDateTime: message.created_at,
+    lastModifiedDateTime: message.updated_at,
+    receivedDateTime: message.received_at,
+    subject: message.subject,
+    bodyPreview: "",
+    importance: message.importance,
+    parentFolderId: message.folder_id,
+    conversationId: message.conversation_id,
+    internetMessageId: message.internet_message_id,
+    isRead: message.is_read,
+    isDraft: message.is_draft,
+    from: address(message.from_name, message.from_address),
+    sender: address(message.from_name, message.from_address),
+    categories: message.categories,
+    flag: { flagStatus: message.flag_status },
+  };
+}
+
+export function formatFolder(ms: MicrosoftStore, folder: MicrosoftMailFolder) {
+  const all = ms.messages.findBy("user_email", folder.user_email).filter((m) => m.folder_id === folder.folder_id);
+  return {
+    id: folder.folder_id,
+    displayName: folder.display_name,
+    parentFolderId: folder.parent_folder_id,
+    childFolderCount: ms.mailFolders
+      .findBy("user_email", folder.user_email)
+      .filter((f) => f.parent_folder_id === folder.folder_id).length,
+    unreadItemCount: all.filter((m) => !m.is_read).length,
+    totalItemCount: all.length,
+    isHidden: false,
+  };
+}
+
+/** The MIME message's top-level headers, unfolded, by lowercase name; the
+ * first of each. */
+export function parseHeaders(mime: string): Map<string, string> {
+  const end = mime.search(/\r?\n\r?\n/);
+  const block = (end === -1 ? mime : mime.slice(0, end)).replace(/\r?\n[ \t]+/g, " ");
+  const headers = new Map<string, string>();
+  for (const line of block.split(/\r?\n/)) {
+    const colon = line.indexOf(":");
+    if (colon <= 0) continue;
+    const name = line.slice(0, colon).trim().toLowerCase();
+    if (!headers.has(name)) headers.set(name, line.slice(colon + 1).trim());
+  }
+  return headers;
+}
+
+/** `Name <address>` or a bare address. */
+export function parseMailbox(value: string): { name: string | null; address: string } | null {
+  const angle = value.match(/^\s*(?:"?([^"<]*?)"?\s*)?<([^>]+)>\s*$/);
+  if (angle) return { name: angle[1]?.trim() || null, address: angle[2].trim() };
+  const bare = value.trim();
+  return bare.includes("@") ? { name: null, address: bare } : null;
+}
+
+/** The addresses in an address-list header. */
+export function parseAddresses(value: string): string[] {
+  return [...value.matchAll(/<([^>@\s]+@[^>\s]+)>|([^\s,<>"]+@[^\s,<>"]+)/g)].map((m) => (m[1] ?? m[2]).toLowerCase());
+}
diff --git a/packages/@emulators/microsoft/src/routes/mail.ts b/packages/@emulators/microsoft/src/routes/mail.ts
new file mode 100644
index 0000000..3cc3bd3
--- /dev/null
+++ b/packages/@emulators/microsoft/src/routes/mail.ts
@@ -0,0 +1,288 @@
+import type { Context, RouteContext } from "@emulators/core";
+import { getMicrosoftStore } from "../store.js";
+import type { MicrosoftMessage } from "../entities.js";
+import {
+  changeMessage,
+  createMessage,
+  currentChange,
+  deleteMessage,
+  ensureMailbox,
+  findFolder,
+  findMessage,
+  folderChanges,
+  formatFolder,
+  formatMessage,
+  generateGraphId,
+  parseAddresses,
+  parseHeaders,
+} from "../mail.js";
+
+/** Messages per delta page unless the client prefers another size. */
+const DEFAULT_PAGE_SIZE = 10;
+
+function graphError(c: Context, status: 400 | 401 | 404 | 410, code: string, message: string) {
+  return c.json({ error: { code, message } }, status);
+}
+
+/** Microsoft Graph mail: folders, messages, their delta queries, moving,
+ * flagging and sending. Messages are kept as MIME; ids never change, as
+ * with `Prefer: IdType="ImmutableId"`. */
+export function mailRoutes({ app, store, baseUrl }: RouteContext): void {
+  const ms = getMicrosoftStore(store);
+
+  const user = (c: Context): string | Response => {
+    const authUser = c.get("authUser");
+    if (!authUser) return graphError(c, 401, "InvalidAuthenticationToken", "Access token is empty.");
+    ensureMailbox(ms, authUser.login);
+    return authUser.login;
+  };
+
+  const folderNotFound = (c: Context) =>
+    graphError(c, 404, "ErrorItemNotFound", "The specified object was not found in the store.");
+
+  // ---------- Folders ----------
+
+  app.get("/v1.0/me/mailFolders", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const folders = ms.mailFolders.findBy("user_email", email).filter((f) => f.parent_folder_id === null);
+    return c.json({ value: folders.map((f) => formatFolder(ms, f)) });
+  });
+
+  app.get("/v1.0/me/mailFolders/:folder", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const folder = findFolder(ms, email, c.req.param("folder"));
+    if (!folder) return folderNotFound(c);
+    return c.json(formatFolder(ms, folder));
+  });
+
+  app.get("/v1.0/me/mailFolders/:folder/childFolders", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const folder = findFolder(ms, email, c.req.param("folder"));
+    if (!folder) return folderNotFound(c);
+    const children = ms.mailFolders
+      .findBy("user_email", email)
+      .filter((f) => f.parent_folder_id === folder.folder_id);
+    return c.json({ value: children.map((f) => formatFolder(ms, f)) });
+  });
+
+  const createFolder = async (c: Context, parent: string | null) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const body = (await c.req.json().catch(() => ({}))) as { displayName?: unknown };
+    if (typeof body.displayName !== "string" || body.displayName === "") {
+      return graphError(c, 400, "ErrorInvalidRequest", "displayName is required.");
+    }
+    const folder = ms.mailFolders.insert({
+      folder_id: generateGraphId("AAMkFolder"),
+      user_email: email,
+      display_name: body.displayName,
+      parent_folder_id: parent,
+      well_known_name: null,
+    });
+    return c.json(formatFolder(ms, folder), 201);
+  };
+
+  app.post("/v1.0/me/mailFolders", (c) => createFolder(c, null));
+
+  app.post("/v1.0/me/mailFolders/:folder/childFolders", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const parent = findFolder(ms, email, c.req.param("folder"));
+    if (!parent) return folderNotFound(c);
+    return createFolder(c, parent.folder_id);
+  });
+
+  // ---------- Delta ----------
+
+  app.get("/v1.0/me/mailFolders/:folder/messages/delta", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const folder = findFolder(ms, email, c.req.param("folder"));
+    if (!folder) return folderNotFound(c);
+
+    const deltaToken = c.req.query("$deltatoken");
+    const skipToken = c.req.query("$skiptoken");
+    let since: number;
+    let upto: number;
+    let offset: number;
+    if (skipToken !== undefined) {
+      try {
+        ({ since, upto, offset } = JSON.parse(Buffer.from(skipToken, "base64url").toString()));
+      } catch {
+        return graphError(c, 400, "ErrorInvalidUrlQuery", "The skip token is invalid.");
+      }
+    } else {
+      since = deltaToken === undefined ? 0 : Number(deltaToken);
+      if (!Number.isInteger(since) || since < 0 || since > currentChange(store, email)) {
+        return graphError(c, 410, "SyncStateNotFound", "The sync state is not found or has expired.");
+      }
+      upto = currentChange(store, email);
+      offset = 0;
+    }
+
+    const prefer = c.req.header("Prefer") ?? "";
+    const pageSize = Number(prefer.match(/odata\.maxpagesize=(\d+)/)?.[1] ?? DEFAULT_PAGE_SIZE);
+    let changes = folderChanges(ms, email, folder.folder_id, since, upto);
+    // The first round lists what is there; nothing has left yet.
+    if (since === 0) changes = changes.filter((change) => "message" in change);
+    const page = changes.slice(offset, offset + pageSize);
+    const value = page.map((change) =>
+      "message" in change
+        ? formatMessage(change.message)
+        : { "@odata.type": "#microsoft.graph.message", id: change.removed, "@removed": { reason: "deleted" } },
+    );
+    const link = `${baseUrl}/v1.0/me/mailFolders/${folder.folder_id}/messages/delta`;
+    const more = offset + pageSize < changes.length;
+    return c.json({
+      "@odata.context": `${baseUrl}/v1.0/$metadata#Collection(message)`,
+      value,
+      ...(more
+        ? {
+            "@odata.nextLink": `${link}?$skiptoken=${Buffer.from(
+              JSON.stringify({ since, upto, offset: offset + pageSize }),
+            ).toString("base64url")}`,
+          }
+        : { "@odata.deltaLink": `${link}?$deltatoken=${upto}` }),
+    });
+  });
+
+  // ---------- Messages ----------
+
+  const withMessage =
+    (handler: (c: Context, email: string, message: MicrosoftMessage) => Response | Promise<Response>) =>
+    (c: Context) => {
+      const email = user(c);
+      if (email instanceof Response) return email;
+      const message = findMessage(ms, email, c.req.param("message") ?? "");
+      if (!message) return folderNotFound(c);
+      return handler(c, email, message);
+    };
+
+  app.get(
+    "/v1.0/me/messages/:message",
+    withMessage((c, _email, message) => c.json(formatMessage(message))),
+  );
+
+  app.get(
+    "/v1.0/me/messages/:message/$value",
+    withMessage((c, _email, message) => c.body(message.mime, 200, { "Content-Type": "text/plain" })),
+  );
+
+  app.patch(
+    "/v1.0/me/messages/:message",
+    withMessage(async (c, _email, message) => {
+      const body = (await c.req.json().catch(() => null)) as Record<string, unknown> | null;
+      if (!body) return graphError(c, 400, "ErrorInvalidRequest", "The request body is not JSON.");
+      const update: Parameters<typeof changeMessage>[2] = {};
+      if (typeof body.isRead === "boolean") update.is_read = body.isRead;
+      const flag = body.flag as { flagStatus?: unknown } | undefined;
+      if (flag && ["notFlagged", "flagged", "complete"].includes(flag.flagStatus as string)) {
+        update.flag_status = flag.flagStatus as MicrosoftMessage["flag_status"];
+      }
+      if (["low", "normal", "high"].includes(body.importance as string)) {
+        update.importance = body.importance as MicrosoftMessage["importance"];
+      }
+      if (Array.isArray(body.categories) && body.categories.every((x) => typeof x === "string")) {
+        update.categories = body.categories as string[];
+      }
+      return c.json(formatMessage(changeMessage(store, message, update)));
+    }),
+  );
+
+  app.post(
+    "/v1.0/me/messages/:message/move",
+    withMessage(async (c, email, message) => {
+      const body = (await c.req.json().catch(() => ({}))) as { destinationId?: unknown };
+      const destination =
+        typeof body.destinationId === "string" ? findFolder(ms, email, body.destinationId) : undefined;
+      if (!destination) return folderNotFound(c);
+      return c.json(formatMessage(changeMessage(store, message, { folder_id: destination.folder_id })), 201);
+    }),
+  );
+
+  app.delete(
+    "/v1.0/me/messages/:message",
+    withMessage((c, _email, message) => {
+      deleteMessage(store, message);
+      return c.body(null, 204);
+    }),
+  );
+
+  /** A message created from MIME (base64 in a text/plain body). */
+  const mimeBody = async (c: Context): Promise<string | null> => {
+    if (!(c.req.header("Content-Type") ?? "").includes("text/plain")) return null;
+    const mime = Buffer.from((await c.req.text()).trim(), "base64").toString("utf8");
+    return parseHeaders(mime).size > 0 ? mime : null;
+  };
+
+  app.post("/v1.0/me/mailFolders/:folder/messages", async (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const folder = findFolder(ms, email, c.req.param("folder"));
+    if (!folder) return folderNotFound(c);
+    const mime = await mimeBody(c);
+    if (mime === null) {
+      return graphError(c, 400, "ErrorMimeContentInvalid", "The emulator creates messages from MIME only.");
+    }
+    const message = createMessage(store, email, folder, { mime, isDraft: folder.well_known_name === "drafts" });
+    return c.json(formatMessage(message), 201);
+  });
+
+  // ---------- Sending ----------
+
+  app.post("/v1.0/me/sendMail", async (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    let mime = await mimeBody(c);
+    let saveToSentItems = true;
+    if (mime === null) {
+      const body = (await c.req.json().catch(() => null)) as {
+        message?: {
+          subject?: string;
+          body?: { contentType?: string; content?: string };
+          toRecipients?: Array<{ emailAddress?: { address?: string } }>;
+          ccRecipients?: Array<{ emailAddress?: { address?: string } }>;
+        };
+        saveToSentItems?: boolean;
+      } | null;
+      if (!body?.message) return graphError(c, 400, "ErrorInvalidRequest", "A message is required.");
+      const list = (r?: Array<{ emailAddress?: { address?: string } }>) =>
+        (r ?? []).map((x) => x.emailAddress?.address).filter(Boolean).join(", ");
+      const html = body.message.body?.contentType?.toLowerCase() === "html";
+      mime = [
+        `From: ${email}`,
+        `To: ${list(body.message.toRecipients)}`,
+        ...(body.message.ccRecipients?.length ? [`Cc: ${list(body.message.ccRecipients)}`] : []),
+        `Subject: ${body.message.subject ?? ""}`,
+        `Message-ID: <${generateGraphId("")}@emulate.microsoft.local>`,
+        `Date: ${new Date().toUTCString()}`,
+        "MIME-Version: 1.0",
+        `Content-Type: text/${html ? "html" : "plain"}; charset=utf-8`,
+        "",
+        body.message.body?.content ?? "",
+      ].join("\r\n");
+      saveToSentItems = body.saveToSentItems ?? true;
+    }
+    const headers = parseHeaders(mime);
+    const recipients = ["to", "cc", "bcc"].flatMap((h) => parseAddresses(headers.get(h) ?? ""));
+    if (recipients.length === 0) {
+      return graphError(c, 400, "ErrorInvalidRecipients", "At least one recipient is not valid.");
+    }
+    const receivedAt = new Date().toISOString();
+    if (saveToSentItems) {
+      createMessage(store, email, findFolder(ms, email, "sentitems")!, { mime, isRead: true, receivedAt });
+    }
+    // Recipients do not see who else was Bcc'd.
+    const delivered = mime.replace(/^Bcc:.*(?:\r?\n[ \t].*)*\r?\n/im, "");
+    for (const address of new Set(recipients)) {
+      const recipient = ms.users.findOneBy("email", address as never);
+      if (!recipient) continue;
+      const inbox = findFolder(ms, recipient.email, "inbox")!;
+      createMessage(store, recipient.email, inbox, { mime: delivered, receivedAt });
+    }
+    return c.body(null, 202);
+  });
+}
