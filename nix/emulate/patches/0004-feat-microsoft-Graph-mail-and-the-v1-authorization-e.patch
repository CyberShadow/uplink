+++ b/packages/@emulators/microsoft/src/__tests__/mail.test.ts
@@ -0,0 +1,234 @@
+import { describe, it, expect, beforeEach } from "vitest";
+import { Hono } from "@emulators/core";
+import { Store, WebhookDispatcher, authMiddleware, type TokenMap } from "@emulators/core";
+import { microsoftPlugin, seedFromConfig } from "../index.js";
+
+const base = "http://localhost:4000";
+const ALICE = "alice@example.com";
+const BOB = "bob@example.com";
+
+function createTestApp() {
+  const store = new Store();
+  const tokenMap: TokenMap = new Map();
+  const app = new Hono();
+  app.use("*", authMiddleware(tokenMap));
+  microsoftPlugin.register(app as any, store, new WebhookDispatcher(), base, tokenMap);
+  seedFromConfig(store, base, { users: [{ email: ALICE, name: "Alice" }, { email: BOB, name: "Bob" }] });
+  tokenMap.set("alice-token", { login: ALICE, id: 1, scopes: [] });
+  tokenMap.set("bob-token", { login: BOB, id: 2, scopes: [] });
+  return app;
+}
+
+function mime(subject: string, extra: string[] = []): string {
+  return [
+    "From: Carol <carol@example.net>",
+    `To: ${ALICE}`,
+    `Subject: ${subject}`,
+    `Message-ID: <${subject.replace(/\W/g, "")}@example.net>`,
+    "Date: Tue, 3 Nov 2026 10:00:00 +0000",
+    ...extra,
+    "",
+    `Body of ${subject}`,
+  ].join("\r\n");
+}
+
+describe("Microsoft Graph mail", () => {
+  let app: Hono;
+  const request = (path: string, init: RequestInit = {}, token = "alice-token") =>
+    app.request(`${base}${path}`, {
+      ...init,
+      headers: { Authorization: `Bearer ${token}`, ...(init.headers as Record<string, string>) },
+    });
+  const json = async (path: string, init: RequestInit = {}, token?: string) => {
+    const res = await request(path, init, token);
+    expect(res.status, `${init.method ?? "GET"} ${path}`).toBeLessThan(300);
+    return (await res.json()) as any;
+  };
+  const importMessage = (folder: string, raw: string) =>
+    json(`/v1.0/me/mailFolders/${folder}/messages`, {
+      method: "POST",
+      headers: { "Content-Type": "text/plain" },
+      body: Buffer.from(raw).toString("base64"),
+    });
+  /** Follows a delta query to its end: the items, and the delta link. */
+  const delta = async (url: string, pageSize?: number) => {
+    const items: any[] = [];
+    let next: string = url;
+    let pages = 0;
+    while (true) {
+      const page: any = await json(next.replace(base, ""), {
+        headers: pageSize ? { Prefer: `odata.maxpagesize=${pageSize}` } : {},
+      });
+      pages++;
+      items.push(...page.value);
+      if (page["@odata.deltaLink"]) return { items, link: page["@odata.deltaLink"] as string, pages };
+      next = page["@odata.nextLink"]!;
+    }
+  };
+
+  beforeEach(() => {
+    app = createTestApp();
+  });
+
+  it("needs a token", async () => {
+    const res = await app.request(`${base}/v1.0/me/mailFolders`);
+    expect(res.status).toBe(401);
+  });
+
+  it("lists the well-known folders, by id or name, and creates folders", async () => {
+    const { value } = await json("/v1.0/me/mailFolders");
+    expect(value.map((f: any) => f.displayName)).toEqual([
+      "Inbox",
+      "Drafts",
+      "Sent Items",
+      "Deleted Items",
+      "Junk Email",
+      "Archive",
+      "Outbox",
+    ]);
+    const inbox = await json("/v1.0/me/mailFolders/Inbox");
+    expect(inbox.id).toBe(value[0].id);
+
+    const projects = await json("/v1.0/me/mailFolders/inbox/childFolders", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ displayName: "Projects" }),
+    });
+    expect(projects.parentFolderId).toBe(inbox.id);
+    expect((await json("/v1.0/me/mailFolders/inbox")).childFolderCount).toBe(1);
+    const children = await json(`/v1.0/me/mailFolders/${inbox.id}/childFolders`);
+    expect(children.value.map((f: any) => f.displayName)).toEqual(["Projects"]);
+  });
+
+  it("stores messages as MIME, serving them back with $value", async () => {
+    const raw = mime("Lunch");
+    const message = await importMessage("inbox", raw);
+    expect(message.subject).toBe("Lunch");
+    expect(message.from.emailAddress).toEqual({ name: "Carol", address: "carol@example.net" });
+    expect(message.internetMessageId).toBe("<Lunch@example.net>");
+    expect(message.receivedDateTime).toBe("2026-11-03T10:00:00.000Z");
+    expect(message.isRead).toBe(false);
+    const res = await request(`/v1.0/me/messages/${message.id}/$value`);
+    expect(await res.text()).toBe(raw);
+    // Replies join the conversation.
+    const reply = await importMessage("inbox", mime("Re Lunch", ["In-Reply-To: <Lunch@example.net>"]));
+    expect(reply.conversationId).toBe(message.conversationId);
+  });
+
+  it("reports a folder's changes through delta links", async () => {
+    const first = await importMessage("inbox", mime("First"));
+    await importMessage("inbox", mime("Second"));
+    await importMessage("inbox", mime("Third"));
+    const initial = await delta("/v1.0/me/mailFolders/inbox/messages/delta", 2);
+    expect(initial.pages).toBe(2);
+    expect(initial.items.map((m) => m.subject)).toEqual(["First", "Second", "Third"]);
+
+    // Nothing new.
+    const quiet = await delta(initial.link);
+    expect(quiet.items).toEqual([]);
+
+    await json(`/v1.0/me/messages/${first.id}`, {
+      method: "PATCH",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        isRead: true,
+        flag: { flagStatus: "flagged" },
+        importance: "high",
+        categories: ["Red category"],
+      }),
+    });
+    const changed = await delta(quiet.link);
+    expect(changed.items).toHaveLength(1);
+    expect(changed.items[0]).toMatchObject({
+      id: first.id,
+      isRead: true,
+      flag: { flagStatus: "flagged" },
+      importance: "high",
+      categories: ["Red category"],
+    });
+
+    // Moved: gone from the Inbox, in the Archive under the same id.
+    const archive = await delta("/v1.0/me/mailFolders/archive/messages/delta");
+    const moved = await json(`/v1.0/me/messages/${first.id}/move`, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ destinationId: "archive" }),
+    });
+    expect(moved.id).toBe(first.id);
+    const fromInbox = await delta(changed.link);
+    expect(fromInbox.items).toEqual([
+      { "@odata.type": "#microsoft.graph.message", id: first.id, "@removed": { reason: "deleted" } },
+    ]);
+    const intoArchive = await delta(archive.link);
+    expect(intoArchive.items.map((m) => [m.id, m.parentFolderId])).toEqual([[first.id, moved.parentFolderId]]);
+
+    // Deleted.
+    const res = await request(`/v1.0/me/messages/${first.id}`, { method: "DELETE" });
+    expect(res.status).toBe(204);
+    expect((await delta(intoArchive.link)).items.map((m) => m["@removed"])).toEqual([{ reason: "deleted" }]);
+    expect((await request(`/v1.0/me/messages/${first.id}`)).status).toBe(404);
+  });
+
+  it("answers 410 for a delta token it does not know", async () => {
+    const res = await request("/v1.0/me/mailFolders/inbox/messages/delta?$deltatoken=999");
+    expect(res.status).toBe(410);
+    expect(((await res.json()) as any).error.code).toBe("SyncStateNotFound");
+  });
+
+  it("sends MIME, keeping a copy in Sent Items and delivering to the recipients", async () => {
+    const raw = [
+      `From: ${ALICE}`,
+      `To: Bob <${BOB}>`,
+      "Bcc: dave@example.org",
+      "Subject: Hello Bob",
+      "Message-ID: <hello@example.com>",
+      "",
+      "Hi!",
+    ].join("\r\n");
+    const res = await request("/v1.0/me/sendMail", {
+      method: "POST",
+      headers: { "Content-Type": "text/plain" },
+      body: Buffer.from(raw).toString("base64"),
+    });
+    expect(res.status).toBe(202);
+    const sent = await delta("/v1.0/me/mailFolders/sentitems/messages/delta");
+    expect(sent.items.map((m) => [m.subject, m.isRead])).toEqual([["Hello Bob", true]]);
+    const received = (await delta("/v1.0/me/mailFolders/inbox/messages/delta", undefined)).items;
+    expect(received).toEqual([]);
+    const bobs = await json("/v1.0/me/mailFolders/inbox/messages/delta", {}, "bob-token");
+    expect(bobs.value.map((m: any) => [m.subject, m.internetMessageId, m.isRead])).toEqual([
+      ["Hello Bob", "<hello@example.com>", false],
+    ]);
+    const delivered = await (await request(`/v1.0/me/messages/${bobs.value[0].id}/$value`, {}, "bob-token")).text();
+    expect(delivered).not.toContain("Bcc:");
+  });
+
+  it("sends JSON messages too", async () => {
+    const res = await request("/v1.0/me/sendMail", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        message: {
+          subject: "Plain",
+          body: { contentType: "Text", content: "Hello" },
+          toRecipients: [{ emailAddress: { address: BOB } }],
+        },
+      }),
+    });
+    expect(res.status).toBe(202);
+    const bobs = await json("/v1.0/me/mailFolders/inbox/messages/delta", {}, "bob-token");
+    expect(bobs.value.map((m: any) => m.subject)).toEqual(["Plain"]);
+  });
+
+  it("serves the v1 authorization page with the resource's default scope", async () => {
+    const res = await app.request(
+      `${base}/common/oauth2/authorize?client_id=c&response_type=code&redirect_uri=urn:ietf:wg:oauth:2.0:oob&resource=https://graph.microsoft.com`,
+    );
+    expect(res.status).toBe(302);
+    const location = new URL(res.headers.get("location")!, base);
+    expect(location.pathname).toBe("/oauth2/v2.0/authorize");
+    expect(location.searchParams.get("scope")).toBe("https://graph.microsoft.com/.default");
+    expect(location.searchParams.get("redirect_uri")).toBe("urn:ietf:wg:oauth:2.0:oob");
+    expect(location.searchParams.has("resource")).toBe(false);
+  });
+});
