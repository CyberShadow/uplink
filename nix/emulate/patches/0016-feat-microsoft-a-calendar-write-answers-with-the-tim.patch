 export function calendarRoutes({ app, store, baseUrl }: RouteContext): void {
   const ms = getMicrosoftStore(store);
 
@@ -67,6 +69,18 @@ export function calendarRoutes({ app, store, baseUrl }: RouteContext): void {
     return { start, end };
   };
 
+  /** What a write of `body` answers of the event `json`: Graph gives
+   * the times written in the zones they were given in, heeding
+   * `Prefer: outlook.timezone` only in reads. */
+  const asWritten = (json: Record<string, unknown>, body: Record<string, unknown>) => {
+    const out = { ...json };
+    for (const key of ["start", "end"]) {
+      const time = body[key] as { dateTime: string; timeZone: string } | undefined;
+      if (time) out[key] = { dateTime: `${time.dateTime.slice(0, 19)}.0000000`, timeZone: time.timeZone };
+    }
+    return out;
+  };
+
   // ---------- Events ----------
 
