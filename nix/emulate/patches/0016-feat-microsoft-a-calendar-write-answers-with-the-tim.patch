@@ -89,7 +103,7 @@ export function calendarRoutes({ app, store, baseUrl }: RouteContext): void {
     if (transactionId !== null && typeof transactionId !== "string") return invalid(c, "transactionId is a string.");
     // Created already, by a POST the client retries.
     const created = transactionId !== null && ms.events.findBy("user_email", email).find((e) => e.transaction_id === transactionId);
-    if (created) return c.json(formatEvent(created), 201);
