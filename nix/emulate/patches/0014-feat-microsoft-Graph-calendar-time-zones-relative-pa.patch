+/** The IANA time zone a Graph time zone name names, Windows' or IANA's;
+ * `null` if it names none. */
+export function ianaZone(name: string): string | null {
+  if (name.toUpperCase() === "UTC") return "UTC";
+  const zone = WINDOWS_ZONES[name] ?? name;
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: zone });
+    return zone;
+  } catch {
     return null;
   }
+}
+
+/** The zone's offset from UTC at `ms`. */
+function offset(ms: number, zone: string): number {
+  const parts = Object.fromEntries(
+    new Intl.DateTimeFormat("en-US", {
+      timeZone: zone,
+      hourCycle: "h23",
+      year: "numeric",
+      month: "2-digit",
+      day: "2-digit",
+      hour: "2-digit",
+      minute: "2-digit",
+      second: "2-digit",
+    })
+      .formatToParts(ms)
+      .map((p) => [p.type, p.value]),
+  );
+  const wall = Date.UTC(+parts.year, +parts.month - 1, +parts.day, +parts.hour, +parts.minute, +parts.second);
+  return wall - Math.floor(ms / 1000) * 1000;
+}
+
+/** Milliseconds since the epoch of a time as given, in the zone named; an
+ * all-day event's, a date wherever one is, as of UTC. */
+export function givenMs(dateTime: string, zone: string, allDay: boolean): number {
+  const wall = utcMs(dateTime);
+  if (allDay) return wall;
+  const iana = ianaZone(zone)!;
+  return wall - offset(wall - offset(wall, iana), iana);
+}
