+/**
+ * Like Google for installed apps (and RFC 8252 section 7.3), a loopback IP
+ * redirect matches a registered loopback redirect on any port, since native
+ * apps listen on whatever port is free.
+ */
+export function matchesGoogleRedirectUri(incoming: string, registered: string[]): boolean {
+  if (matchesRedirectUri(incoming, registered)) return true;
+  const withoutPort = (uri: string): string | null => {
+    try {
+      const url = new URL(uri);
+      if (url.protocol !== "http:" || (url.hostname !== "127.0.0.1" && url.hostname !== "[::1]")) return null;
+      url.port = "";
+      return url.toString();
+    } catch {
+      return null;
+    }
+  };
+  const loopback = withoutPort(incoming);
+  return loopback !== null && registered.some((uri) => withoutPort(uri) === loopback);
+}
