+describe("Google loopback redirects", () => {
+  it("match a registered loopback redirect on any port", async () => {
+    const { matchesGoogleRedirectUri } = await import("../routes/oauth.js");
+    const registered = ["http://127.0.0.1/", "http://[::1]/cb", "https://app.example.com/cb"];
+    expect(matchesGoogleRedirectUri("http://127.0.0.1:43123/", registered)).toBe(true);
+    expect(matchesGoogleRedirectUri("http://[::1]:8080/cb", registered)).toBe(true);
+    expect(matchesGoogleRedirectUri("http://127.0.0.1:43123/other", registered)).toBe(false);
+    expect(matchesGoogleRedirectUri("http://localhost:43123/", registered)).toBe(false);
+    expect(matchesGoogleRedirectUri("https://app.example.com:8443/cb", registered)).toBe(false);
+    expect(matchesGoogleRedirectUri("https://app.example.com/cb", registered)).toBe(true);
+  });
+
+  it("are accepted by the authorization page", async () => {
+    const store = new Store();
+    const app = new Hono<AppEnv>();
+    googlePlugin.register(app, store, new WebhookDispatcher(), base);
+    seedFromConfig(store, base, { oauth_clients: [{ ...client, redirect_uris: ["http://127.0.0.1"] }] });
+    const page = (redirect: string) =>
+      app.request(
+        `${base}/o/oauth2/v2/auth?${new URLSearchParams({
+          client_id: client.client_id,
+          redirect_uri: redirect,
+          response_type: "code",
+          scope: "openid",
+        })}`,
+      );
+    expect((await page("http://127.0.0.1:43123/")).status).toBe(200);
+    expect((await page("http://127.0.0.1:43123/elsewhere")).status).toBe(400);
+  });
+});
