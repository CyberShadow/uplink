diff --git a/packages/@emulators/microsoft/src/routes/calendar.ts b/packages/@emulators/microsoft/src/routes/calendar.ts
new file mode 100644
index 0000000..424ed01
--- /dev/null
+++ b/packages/@emulators/microsoft/src/routes/calendar.ts
@@ -0,0 +1,251 @@
+import type { Context, RouteContext } from "@emulators/core";
+import { getMicrosoftStore } from "../store.js";
+import type { MicrosoftEvent } from "../entities.js";
+import {
+  currentCalendarChange,
+  fieldsOf,
+  formatEvent,
+  instancesOf,
+  isSupportedRecurrence,
+  overlaps,
+  parseWindowTime,
+  syncInstances,
+} from "../calendar.js";
+import { generateGraphId } from "../mail.js";
+
+/** Events per delta page unless the client prefers another size. */
+const DEFAULT_PAGE_SIZE = 10;
+
+function graphError(c: Context, status: 400 | 401 | 404 | 410, code: string, message: string) {
+  return c.json({ error: { code, message } }, status);
+}
+
+/** Where a delta round is: the window, the changes it covers, and how far
+ * into them it has got. */
+interface DeltaState {
+  start: number;
+  end: number;
+  since: number;
+  upto: number;
+  offset: number;
+}
+
+const encode = (state: object) => Buffer.from(JSON.stringify(state)).toString("base64url");
+
+/** Microsoft Graph calendar: events and recurring series in the user's
+ * calendar, calendar views of them (series expanded into occurrences),
+ * and delta queries of those views. Times are UTC: the emulator takes
+ * and gives UTC only, as with `Prefer: outlook.timezone="UTC"`. */
+export function calendarRoutes({ app, store, baseUrl }: RouteContext): void {
+  const ms = getMicrosoftStore(store);
+
+  const user = (c: Context): string | Response => {
+    const authUser = c.get("authUser");
+    if (!authUser) return graphError(c, 401, "InvalidAuthenticationToken", "Access token is empty.");
+    return authUser.login;
+  };
+  const notFound = (c: Context) =>
+    graphError(c, 404, "ErrorItemNotFound", "The specified object was not found in the store.");
+  const invalid = (c: Context, message: string) => graphError(c, 400, "ErrorInvalidRequest", message);
+
+  const eventOf = (email: string, id: string) =>
+    ms.events.findBy("event_id", id).find((e) => e.user_email === email);
+  const instanceOf = (email: string, id: string) =>
+    ms.eventInstances.findBy("instance_id", id).find((i) => i.user_email === email);
+  const resync = (event: MicrosoftEvent) => syncInstances(store, event.user_email, event.event_id, instancesOf(event));
+
+  /** The window of a calendar view request, or the error answering it. */
+  const windowOf = (c: Context): { start: number; end: number } | Response => {
+    const start = parseWindowTime(c.req.query("startDateTime") ?? c.req.query("startdatetime"));
+    const end = parseWindowTime(c.req.query("endDateTime") ?? c.req.query("enddatetime"));
+    if (start === null || end === null || end <= start) {
+      return invalid(c, "startDateTime and endDateTime are required, and must make a range.");
+    }
+    return { start, end };
+  };
+
+  // ---------- Events ----------
+
+  app.post("/v1.0/me/events", async (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const body = (await c.req.json().catch(() => null)) as Record<string, unknown> | null;
+    if (!body) return invalid(c, "The request body is not JSON.");
+    const fields = fieldsOf(body);
+    if (!fields || fields.start === undefined || fields.end === undefined) {
+      return invalid(c, "An event needs a start and an end, in UTC.");
+    }
+    const recurrence = body.recurrence ?? null;
+    if (recurrence !== null && !isSupportedRecurrence(recurrence)) {
+      return invalid(c, "The emulator expands daily, weekly, absoluteMonthly and absoluteYearly patterns only.");
+    }
+    const event = ms.events.insert({
+      event_id: generateGraphId("AAMkEvent"),
+      user_email: email,
+      ical_uid: generateGraphId("040000008200E00074C5B7101A82E008"),
+      subject: "",
+      body: "",
+      location: "",
+      is_all_day: false,
+      ...fields,
+      start: fields.start,
+      end: fields.end,
+      recurrence,
+      exceptions: {},
+    });
+    resync(event);
+    return c.json(formatEvent(event), 201);
+  });
+
+  app.get("/v1.0/me/events/:event", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const id = c.req.param("event");
+    const event = eventOf(email, id);
+    if (event) return c.json(formatEvent(event));
+    const instance = instanceOf(email, id);
+    return instance ? c.json(JSON.parse(instance.json)) : notFound(c);
+  });
+
+  app.get("/v1.0/me/events/:event/instances", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const window = windowOf(c);
+    if (window instanceof Response) return window;
+    const event = eventOf(email, c.req.param("event"));
+    if (!event) return notFound(c);
+    const instances = ms.eventInstances
+      .findBy("event_id", event.event_id)
+      .filter((i) => i.user_email === email && overlaps(i, window.start, window.end))
+      .sort((a, b) => a.start.localeCompare(b.start));
+    return c.json({ value: instances.map((i) => JSON.parse(i.json)) });
+  });
+
+  /** Changes a series' occurrence: it becomes an exception. */
+  const changeOccurrence = (event: MicrosoftEvent, instanceJson: string, change: object | null) => {
+    const { originalStart } = JSON.parse(instanceJson) as { originalStart: string };
+    const date = originalStart.slice(0, 10);
+    const exceptions = { ...event.exceptions };
+    exceptions[date] = change === null ? null : { ...exceptions[date], ...change };
+    resync(ms.events.update(event.id, { exceptions })!);
+  };
+
+  app.patch("/v1.0/me/events/:event", async (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const body = (await c.req.json().catch(() => null)) as Record<string, unknown> | null;
+    if (!body) return invalid(c, "The request body is not JSON.");
+    const fields = fieldsOf(body);
+    if (!fields) return invalid(c, "A field is malformed.");
+    const id = c.req.param("event");
+    const event = eventOf(email, id);
+    if (event) {
+      const update: Partial<MicrosoftEvent> = { ...fields };
+      if ("recurrence" in body) {
+        if (body.recurrence !== null && !isSupportedRecurrence(body.recurrence)) {
+          return invalid(c, "The emulator expands daily, weekly, absoluteMonthly and absoluteYearly patterns only.");
+        }
+        update.recurrence = body.recurrence as MicrosoftEvent["recurrence"];
+      }
+      const updated = ms.events.update(event.id, update)!;
+      resync(updated);
+      return c.json(formatEvent(updated));
+    }
+    const instance = instanceOf(email, id);
+    const master = instance && eventOf(email, instance.event_id);
+    if (!instance || !master || instance.instance_id === master.event_id) return notFound(c);
+    changeOccurrence(master, instance.json, fields);
+    return c.json(JSON.parse(instanceOf(email, id)!.json));
+  });
+
+  app.delete("/v1.0/me/events/:event", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const id = c.req.param("event");
+    const event = eventOf(email, id);
+    if (event) {
+      ms.events.delete(event.id);
+      syncInstances(store, email, event.event_id, []);
+      return c.body(null, 204);
+    }
+    const instance = instanceOf(email, id);
+    const master = instance && eventOf(email, instance.event_id);
+    if (!instance || !master) return notFound(c);
+    changeOccurrence(master, instance.json, null);
+    return c.body(null, 204);
+  });
+
+  // ---------- Calendar views ----------
+
+  app.get("/v1.0/me/calendarView", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const window = windowOf(c);
+    if (window instanceof Response) return window;
+    const instances = ms.eventInstances
+      .findBy("user_email", email)
+      .filter((i) => overlaps(i, window.start, window.end))
+      .sort((a, b) => a.start.localeCompare(b.start));
+    return c.json({ value: instances.map((i) => JSON.parse(i.json)) });
+  });
+
+  app.get("/v1.0/me/calendarView/delta", (c) => {
+    const email = user(c);
+    if (email instanceof Response) return email;
+    const deltaToken = c.req.query("$deltatoken");
+    const skipToken = c.req.query("$skiptoken");
+    let state: DeltaState;
+    if (skipToken !== undefined || deltaToken !== undefined) {
+      try {
+        state = JSON.parse(Buffer.from((skipToken ?? deltaToken)!, "base64url").toString());
+      } catch {
+        return graphError(c, 410, "SyncStateNotFound", "The sync state is not found or has expired.");
+      }
+      if (!(state.since <= currentCalendarChange(store, email))) {
+        return graphError(c, 410, "SyncStateNotFound", "The sync state is not found or has expired.");
+      }
+      if (deltaToken !== undefined) state = { ...state, upto: currentCalendarChange(store, email), offset: 0 };
+    } else {
+      const window = windowOf(c);
+      if (window instanceof Response) return window;
+      state = { ...window, since: 0, upto: currentCalendarChange(store, email), offset: 0 };
+    }
+
+    const { start, end, since, upto, offset } = state;
+    const changed = ms.eventInstances
+      .findBy("user_email", email)
+      .filter((i) => i.change > since && i.change <= upto)
+      .map((i) => ({ change: i.change, instance: i }));
+    const present = new Set(changed.map((x) => x.instance.instance_id));
+    const removed = ms.eventInstanceRemovals
+      .findBy("user_email", email)
+      .filter((r) => r.change > since && r.change <= upto && !present.has(r.instance_id))
+      .map((r) => ({ change: r.change, removed: r.instance_id }));
+    // The first round lists what is in the window; later ones also report
+    // as removed what has left it.
+    const changes = [...changed, ...removed]
+      .filter((x) => since > 0 || ("instance" in x && overlaps(x.instance, start, end)))
+      .sort((a, b) => a.change - b.change);
+
+    const prefer = c.req.header("Prefer") ?? "";
+    const pageSize = Number(prefer.match(/odata\.maxpagesize=(\d+)/)?.[1] ?? DEFAULT_PAGE_SIZE);
+    const page = changes.slice(offset, offset + pageSize);
+    const removal = (id: string) => ({ "@odata.type": "#microsoft.graph.event", id, "@removed": { reason: "deleted" } });
+    const value = page.map((x) =>
+      "instance" in x
+        ? overlaps(x.instance, start, end)
+          ? JSON.parse(x.instance.json)
+          : removal(x.instance.instance_id)
+        : removal(x.removed),
+    );
+    const link = `${baseUrl}/v1.0/me/calendarView/delta`;
+    const more = offset + pageSize < changes.length;
+    return c.json({
+      "@odata.context": `${baseUrl}/v1.0/$metadata#Collection(event)`,
+      value,
+      ...(more
+        ? { "@odata.nextLink": `${link}?$skiptoken=${encode({ ...state, offset: offset + pageSize })}` }
+        : { "@odata.deltaLink": `${link}?$deltatoken=${encode({ start, end, since: upto })}` }),
+    });
+  });
+}
