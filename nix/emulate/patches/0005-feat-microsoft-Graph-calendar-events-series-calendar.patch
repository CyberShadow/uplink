+  json: string;
+  /** The calendar's change counter when the instance last changed. */
+  change: number;
+}
+
+/** An instance that no longer exists, for delta queries. */
+export interface MicrosoftEventInstanceRemoval extends Entity {
+  user_email: string;
+  instance_id: string;
+  change: number;
+}
