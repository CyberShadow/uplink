+++ b/packages/@emulators/microsoft/src/calendar.ts
@@ -0,0 +1,246 @@
+import type { Store } from "@emulators/core";
+import { getMicrosoftStore } from "./store.js";
+import type { MicrosoftEvent, MicrosoftEventFields, MicrosoftRecurrence } from "./entities.js";
+
+/** Series without an end date are expanded this far past their start. */
+const HORIZON_DAYS = 3 * 366;
+const DAY = 86_400_000;
+const WEEKDAYS = ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"];
+export const PATTERNS = ["daily", "weekly", "absoluteMonthly", "absoluteYearly"];
+export const RANGES = ["endDate", "noEnd", "numbered"];
+
+/** Advances the calendar's change counter; delta tokens hold its values. */
+export function nextCalendarChange(store: Store, email: string): number {
+  let counters = store.getData<Map<string, number>>("microsoft.calendar.changes");
+  if (!counters) {
+    counters = new Map();
+    store.setData("microsoft.calendar.changes", counters);
+  }
+  const next = (counters.get(email) ?? 0) + 1;
+  counters.set(email, next);
+  return next;
+}
+
+export function currentCalendarChange(store: Store, email: string): number {
+  return store.getData<Map<string, number>>("microsoft.calendar.changes")?.get(email) ?? 0;
+}
+
+/** Milliseconds since the epoch of a UTC `YYYY-MM-DDTHH:mm:ss`. */
+export function utcMs(dateTime: string): number {
+  return Date.parse(`${dateTime}Z`);
+}
+
+function utcString(ms: number): string {
+  return new Date(ms).toISOString().slice(0, 19);
+}
+
+/** A Graph `dateTimeTimeZone` as UTC `YYYY-MM-DDTHH:mm:ss`; the emulator
+ * takes UTC times only. `null` if it is not one. */
+export function parseDateTime(value: unknown): string | null {
+  const { dateTime, timeZone } = (value ?? {}) as { dateTime?: unknown; timeZone?: unknown };
+  if (typeof dateTime !== "string" || (timeZone !== undefined && String(timeZone).toUpperCase() !== "UTC")) {
+    return null;
+  }
+  const ms = Date.parse(dateTime.endsWith("Z") ? dateTime : `${dateTime}Z`);
+  return Number.isNaN(ms) ? null : utcString(ms);
+}
+
+/** A query parameter's date and time (ISO 8601, UTC unless it says). */
+export function parseWindowTime(value: string | undefined): number | null {
+  if (value === undefined) return null;
+  const ms = Date.parse(/[zZ]|[+-]\d\d:?\d\d$/.test(value) ? value : `${value}Z`);
+  return Number.isNaN(ms) ? null : ms;
+}
+
+/** Whether `recurrence` is one the emulator expands. */
+export function isSupportedRecurrence(recurrence: unknown): recurrence is MicrosoftRecurrence {
+  const r = recurrence as MicrosoftRecurrence | null;
+  if (!r?.pattern || !r.range) return false;
+  if (!PATTERNS.includes(r.pattern.type) || !RANGES.includes(r.range.type)) return false;
+  if (!Number.isInteger(r.pattern.interval) || r.pattern.interval < 1) return false;
+  if (Number.isNaN(Date.parse(`${r.range.startDate}T00:00:00Z`))) return false;
+  if (r.pattern.type === "weekly" && !r.pattern.daysOfWeek?.every((d) => WEEKDAYS.includes(d.toLowerCase()))) {
+    return false;
+  }
+  if (r.range.type === "endDate" && Number.isNaN(Date.parse(`${r.range.endDate}T00:00:00Z`))) return false;
+  if (r.range.type === "numbered" && !(Number(r.range.numberOfOccurrences) > 0)) return false;
+  return true;
+}
+
+/** Whether the pattern has an occurrence on `day`, given the range's first
+ * day (both UTC midnights). */
+function matches(pattern: MicrosoftRecurrence["pattern"], first: number, day: number): boolean {
+  const d = new Date(day);
+  const f = new Date(first);
+  const months = (d.getUTCFullYear() - f.getUTCFullYear()) * 12 + d.getUTCMonth() - f.getUTCMonth();
+  switch (pattern.type) {
+    case "daily":
+      return Math.round((day - first) / DAY) % pattern.interval === 0;
+    case "weekly": {
+      const weekStart = first - f.getUTCDay() * DAY;
+      const week = Math.floor((day - weekStart) / (7 * DAY));
+      const days = (pattern.daysOfWeek ?? []).map((x) => x.toLowerCase());
+      return week % pattern.interval === 0 && days.includes(WEEKDAYS[d.getUTCDay()]);
+    }
+    case "absoluteMonthly":
+      return d.getUTCDate() === pattern.dayOfMonth && months % pattern.interval === 0;
+    case "absoluteYearly":
+      return (
+        d.getUTCMonth() + 1 === pattern.month &&
+        d.getUTCDate() === pattern.dayOfMonth &&
+        (months / 12) % pattern.interval === 0
+      );
+  }
+}
+
+/** The original start of each occurrence of the series, at the time of day
+ * the master starts. */
+export function occurrenceStarts(event: MicrosoftEvent): string[] {
+  const r = event.recurrence!;
+  const first = Date.parse(`${r.range.startDate}T00:00:00Z`);
+  const last = r.range.type === "endDate" ? Date.parse(`${r.range.endDate}T00:00:00Z`) : first + HORIZON_DAYS * DAY;
+  const most = r.range.type === "numbered" ? r.range.numberOfOccurrences! : Infinity;
+  const time = event.start.slice(10);
+  const starts: string[] = [];
+  for (let day = first; day <= last && starts.length < most; day += DAY) {
+    if (matches(r.pattern, first, day)) starts.push(`${utcString(day).slice(0, 10)}${time}`);
+  }
+  return starts;
+}
+
+const graphTime = (dateTime: string) => ({ dateTime: `${dateTime}.0000000`, timeZone: "UTC" });
+
+/** Graph's representation of an event, or of one occurrence of a series. */
+export function formatEvent(
+  event: MicrosoftEvent,
+  instance?: { id: string; fields: MicrosoftEventFields; type: "occurrence" | "exception"; originalStart: string },
+) {
+  const fields = instance?.fields ?? event;
+  return {
+    "@odata.type": "#microsoft.graph.event",
+    id: instance?.id ?? event.event_id,
+    iCalUId: event.ical_uid,
+    type: instance?.type ?? (event.recurrence ? "seriesMaster" : "singleInstance"),
+    seriesMasterId: instance ? event.event_id : null,
+    originalStart: instance ? `${instance.originalStart}Z` : null,
+    subject: fields.subject,
+    bodyPreview: fields.body.slice(0, 255),
+    body: { contentType: "text", content: fields.body },
+    start: graphTime(fields.start),
+    end: graphTime(fields.end),
+    isAllDay: fields.is_all_day,
+    location: { displayName: fields.location },
+    recurrence: instance ? null : event.recurrence,
+    isCancelled: false,
+    showAs: "busy",
+    organizer: { emailAddress: { address: event.user_email } },
+  };
+}
+
+export interface Instance {
+  instance_id: string;
+  start: string;
+  end: string;
+  json: string;
+}
+
+/** The instances a calendar view lists of the event: itself, or its
+ * series' occurrences as changed, less those cancelled. */
+export function instancesOf(event: MicrosoftEvent): Instance[] {
+  if (!event.recurrence) {
+    return [{ instance_id: event.event_id, start: event.start, end: event.end, json: JSON.stringify(formatEvent(event)) }];
+  }
+  const duration = utcMs(event.end) - utcMs(event.start);
+  return occurrenceStarts(event).flatMap((originalStart) => {
+    const date = originalStart.slice(0, 10);
+    const exception = event.exceptions[date];
+    if (exception === null) return [];
+    const fields: MicrosoftEventFields = {
+      subject: event.subject,
+      body: event.body,
+      location: event.location,
+      is_all_day: event.is_all_day,
+      start: originalStart,
+      end: utcString(utcMs(originalStart) + duration),
+      ...exception,
+    };
+    const id = occurrenceId(event.event_id, date);
+    const type = exception ? "exception" : "occurrence";
+    return [
+      {
+        instance_id: id,
+        start: fields.start,
+        end: fields.end,
+        json: JSON.stringify(formatEvent(event, { id, fields, type, originalStart })),
+      },
+    ];
+  });
+}
+
+export function occurrenceId(eventId: string, date: string): string {
+  return `${eventId}_${date.replaceAll("-", "")}`;
+}
+
+/** Makes the event's recorded instances `wanted`, recording what changed
+ * and what is gone under one change of the calendar. */
+export function syncInstances(store: Store, email: string, eventId: string, wanted: Instance[]): void {
+  const ms = getMicrosoftStore(store);
+  const recorded = new Map(
+    ms.eventInstances
+      .findBy("event_id", eventId)
+      .filter((i) => i.user_email === email)
+      .map((i) => [i.instance_id, i]),
+  );
+  let change: number | undefined;
+  const next = () => (change ??= nextCalendarChange(store, email));
+  for (const instance of wanted) {
+    const old = recorded.get(instance.instance_id);
+    recorded.delete(instance.instance_id);
+    if (!old) {
+      ms.eventInstances.insert({ ...instance, user_email: email, event_id: eventId, change: next() });
+    } else if (old.json !== instance.json) {
+      ms.eventInstances.update(old.id, { ...instance, change: next() });
+    }
+  }
+  for (const gone of recorded.values()) {
+    ms.eventInstances.delete(gone.id);
+    ms.eventInstanceRemovals.insert({ user_email: email, instance_id: gone.instance_id, change: next() });
+  }
+}
+
+/** The fields of an event, or of an occurrence, that a request body sets;
+ * `null` if one is malformed. */
+export function fieldsOf(body: Record<string, unknown>): Partial<MicrosoftEventFields> | null {
+  const fields: Partial<MicrosoftEventFields> = {};
+  if ("subject" in body) {
+    if (typeof body.subject !== "string") return null;
+    fields.subject = body.subject;
+  }
+  if ("body" in body) {
+    const content = (body.body as { content?: unknown } | null)?.content;
+    if (typeof content !== "string") return null;
+    fields.body = content;
+  }
+  if ("location" in body) {
+    const name = (body.location as { displayName?: unknown } | null)?.displayName;
+    if (typeof name !== "string") return null;
+    fields.location = name;
+  }
+  for (const key of ["start", "end"] as const) {
+    if (key in body) {
+      const time = parseDateTime(body[key]);
+      if (time === null) return null;
+      fields[key] = time;
+    }
+  }
+  if ("isAllDay" in body) {
+    if (typeof body.isAllDay !== "boolean") return null;
+    fields.is_all_day = body.isAllDay;
+  }
+  return fields;
+}
+
+/** Whether the instance (as recorded) overlaps [start, end). */
+export function overlaps(instance: { start: string; end: string }, start: number, end: number): boolean {
+  return utcMs(instance.start) < end && utcMs(instance.end) > start;
+}
