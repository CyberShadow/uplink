+import { describe, it, expect, beforeEach } from "vitest";
+import { Hono } from "@emulators/core";
+import { Store, WebhookDispatcher, authMiddleware, type TokenMap } from "@emulators/core";
+import { microsoftPlugin, seedFromConfig } from "../index.js";
+
+const base = "http://localhost:4000";
+const ALICE = "alice@example.com";
+
+function createTestApp() {
+  const store = new Store();
+  const tokenMap: TokenMap = new Map();
+  const app = new Hono();
+  app.use("*", authMiddleware(tokenMap));
+  microsoftPlugin.register(app as any, store, new WebhookDispatcher(), base, tokenMap);
+  seedFromConfig(store, base, { users: [{ email: ALICE, name: "Alice" }] });
+  tokenMap.set("alice-token", { login: ALICE, id: 1, scopes: [] });
+  return app;
+}
+
+const utc = (dateTime: string) => ({ dateTime, timeZone: "UTC" });
+const WINDOW = "startDateTime=2026-11-01T00:00:00Z&endDateTime=2026-12-01T00:00:00Z";
+
+describe("Microsoft Graph calendar", () => {
+  let app: Hono;
+  const request = (path: string, init: RequestInit = {}) =>
+    app.request(`${base}${path}`, {
+      ...init,
+      headers: {
+        Authorization: "Bearer alice-token",
+        "Content-Type": "application/json",
+        ...(init.headers as Record<string, string>),
+      },
+    });
+  const json = async (path: string, init: RequestInit = {}) => {
+    const res = await request(path, init);
+    expect(res.status, `${init.method ?? "GET"} ${path}`).toBeLessThan(300);
+    return res.status === 204 ? null : ((await res.json()) as any);
+  };
+  const create = (event: object) => json("/v1.0/me/events", { method: "POST", body: JSON.stringify(event) });
+  const view = async () =>
+    (await json(`/v1.0/me/calendarView?${WINDOW}`)).value.map((e: any) => [e.subject, e.start.dateTime, e.type]);
+  /** Follows a delta query to its end: the items, and the delta link. */
+  const delta = async (url: string, pageSize?: number) => {
+    const items: any[] = [];
+    let next = url;
+    while (true) {
+      const page: any = await json(next.replace(base, ""), {
+        headers: pageSize ? { Prefer: `odata.maxpagesize=${pageSize}` } : {},
+      });
+      items.push(...page.value);
+      if (page["@odata.deltaLink"]) return { items, link: page["@odata.deltaLink"] as string };
+      next = page["@odata.nextLink"];
+    }
+  };
+  const weekly = {
+    subject: "Standup",
+    start: utc("2026-11-02T09:00:00"),
+    end: utc("2026-11-02T09:15:00"),
+    recurrence: {
+      pattern: { type: "weekly", interval: 1, daysOfWeek: ["monday", "thursday"] },
+      range: { type: "endDate", startDate: "2026-11-02", endDate: "2026-11-30" },
+    },
+  };
+
+  beforeEach(() => {
+    app = createTestApp();
+  });
+
+  it("lists single events and a series' occurrences in a calendar view", async () => {
+    await create({ subject: "Dentist", start: utc("2026-11-10T14:00:00"), end: utc("2026-11-10T15:00:00") });
+    await create({ subject: "Last year", start: utc("2025-11-10T14:00:00"), end: utc("2025-11-10T15:00:00") });
+    const series = await create(weekly);
+    expect(series.type).toBe("seriesMaster");
+    expect(await view()).toEqual([
+      ["Standup", "2026-11-02T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-05T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-09T09:00:00.0000000", "occurrence"],
+      ["Dentist", "2026-11-10T14:00:00.0000000", "singleInstance"],
+      ["Standup", "2026-11-12T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-16T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-19T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-23T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-26T09:00:00.0000000", "occurrence"],
+      ["Standup", "2026-11-30T09:00:00.0000000", "occurrence"],
+    ]);
+  });
+
+  it("expands daily, monthly and yearly patterns, numbered or without end", async () => {
+    const series = (subject: string, pattern: object, range: object) =>
+      create({
+        subject,
+        start: utc("2026-01-31T08:00:00"),
+        end: utc("2026-01-31T09:00:00"),
+        recurrence: { pattern, range: { startDate: "2026-01-31", ...range } },
+      });
+    await series("Daily", { type: "daily", interval: 100 }, { type: "numbered", numberOfOccurrences: 3 });
+    await series("Monthly", { type: "absoluteMonthly", interval: 2, dayOfMonth: 31 }, { type: "noEnd" });
+    await series("Yearly", { type: "absoluteYearly", interval: 1, month: 1, dayOfMonth: 31 }, { type: "noEnd" });
+    const occurrences = async (window: string) =>
+      (await json(`/v1.0/me/calendarView?${window}`)).value.map((e: any) => `${e.subject} ${e.start.dateTime.slice(0, 10)}`);
+    expect(await occurrences("startDateTime=2026-01-01T00:00:00Z&endDateTime=2027-02-01T00:00:00Z")).toEqual([
+      "Daily 2026-01-31",
+      "Monthly 2026-01-31",
+      "Yearly 2026-01-31",
+      "Monthly 2026-03-31",
+      "Daily 2026-05-11",
+      // Every other month, when it has a 31st.
+      "Monthly 2026-05-31",
+      "Monthly 2026-07-31",
+      "Daily 2026-08-19",
+      "Monthly 2027-01-31",
+      "Yearly 2027-01-31",
+    ]);
+  });
+
+  it("changes and cancels single occurrences, as exceptions", async () => {
+    const series = await create(weekly);
+    const { value: instances } = await json(`/v1.0/me/events/${series.id}/instances?${WINDOW}`);
+    const moved = await json(`/v1.0/me/events/${instances[1].id}`, {
+      method: "PATCH",
+      body: JSON.stringify({ subject: "Standup (moved)", start: utc("2026-11-06T10:00:00"), end: utc("2026-11-06T10:15:00") }),
+    });
+    expect(moved).toMatchObject({ id: instances[1].id, type: "exception", seriesMasterId: series.id });
+    await json(`/v1.0/me/events/${instances[2].id}`, { method: "DELETE" });
+    expect((await view()).slice(0, 3)).toEqual([
+      ["Standup", "2026-11-02T09:00:00.0000000", "occurrence"],
+      ["Standup (moved)", "2026-11-06T10:00:00.0000000", "exception"],
+      ["Standup", "2026-11-12T09:00:00.0000000", "occurrence"],
+    ]);
+  });
+
+  it("reports a calendar view's changes through delta links", async () => {
+    const dentist = await create({ subject: "Dentist", start: utc("2026-11-10T14:00:00"), end: utc("2026-11-10T15:00:00") });
+    const series = await create(weekly);
+    const initial = await delta(`/v1.0/me/calendarView/delta?${WINDOW}`, 4);
+    expect(initial.items).toHaveLength(10);
+    expect((await delta(initial.link)).items).toEqual([]);
+
+    // A series shortened: its later occurrences are removed.
+    await json(`/v1.0/me/events/${series.id}`, {
+      method: "PATCH",
+      body: JSON.stringify({
+        recurrence: { ...weekly.recurrence, range: { ...weekly.recurrence.range, endDate: "2026-11-05" } },
+      }),
+    });
+    const shortened = await delta(initial.link);
+    expect(shortened.items.filter((e) => e["@removed"])).toHaveLength(7);
+
+    // An event moved out of the window is reported as removed; one renamed,
+    // as it is now.
+    await json(`/v1.0/me/events/${dentist.id}`, {
+      method: "PATCH",
+      body: JSON.stringify({ start: utc("2027-01-10T14:00:00"), end: utc("2027-01-10T15:00:00") }),
+    });
+    const { value: [first] } = await json(`/v1.0/me/events/${series.id}/instances?${WINDOW}`);
+    await json(`/v1.0/me/events/${first.id}`, { method: "PATCH", body: JSON.stringify({ subject: "Kickoff" }) });
+    const later = await delta(shortened.link);
+    expect(later.items.map((e) => [e.id, e["@removed"] ? "removed" : e.subject])).toEqual([
+      [dentist.id, "removed"],
+      [first.id, "Kickoff"],
+    ]);
+
+    // Deleting the series removes what is left of it.
+    await json(`/v1.0/me/events/${series.id}`, { method: "DELETE" });
+    expect((await delta(later.link)).items.map((e) => e["@removed"])).toEqual([
+      { reason: "deleted" },
+      { reason: "deleted" },
+    ]);
+  });
+
+  it("answers 410 for a delta token it does not know", async () => {
+    const token = Buffer.from(JSON.stringify({ start: 0, end: 1, since: 99 })).toString("base64url");
+    const res = await request(`/v1.0/me/calendarView/delta?$deltatoken=${token}`);
+    expect(res.status).toBe(410);
+  });
+
+  it("takes UTC times and the patterns it expands only", async () => {
+    const res = await request("/v1.0/me/events", {
+      method: "POST",
+      body: JSON.stringify({
+        subject: "Elsewhere",
+        start: { dateTime: "2026-11-10T14:00:00", timeZone: "Pacific Standard Time" },
+        end: { dateTime: "2026-11-10T15:00:00", timeZone: "Pacific Standard Time" },
+      }),
+    });
+    expect(res.status).toBe(400);
+    const relative = await request("/v1.0/me/events", {
+      method: "POST",
+      body: JSON.stringify({
+        ...weekly,
+        recurrence: { ...weekly.recurrence, pattern: { type: "relativeMonthly", interval: 1 } },
+      }),
+    });
+    expect(relative.status).toBe(400);
+  });
+});
